rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> Put your moderator email here (lowercase) — same as ADMIN_EMAIL in js/firebase-config.js
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "ramy.tefiti@gmail.com";
    }

    // The team document ID is the team's own login ID (uid).
    function isOwner(teamId) {
      return request.auth != null && request.auth.uid == teamId;
    }

    match /teams/{teamId} {
      // A team can only read ITSELF. The moderator can read all teams.
      allow read: if isAdmin() || isOwner(teamId);

      // A team can only create its own document, starting from zero.
      allow create: if isOwner(teamId)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30
        && request.resource.data.progress == 0
        && request.resource.data.solved.size() == 0
        && request.resource.data.wrongAttempts == 0
        && request.resource.data.finished == false;

      // A team can only add progress to ITSELF (never go back, max 6).
      // The moderator can update any team (used for Reset).
      allow update: if isAdmin() || (
        isOwner(teamId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['solved', 'progress', 'wrongAttempts', 'lastActivityMs', 'finished', 'finishedAtMs', 'durationMs'])
        && request.resource.data.progress >= resource.data.progress
        && request.resource.data.progress <= 6
        && request.resource.data.solved.size() == request.resource.data.progress
        && request.resource.data.wrongAttempts >= resource.data.wrongAttempts
      );

      // Only the moderator can delete teams.
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
